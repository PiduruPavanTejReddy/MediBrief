# ====================================================================
# MediBrief - Environment Configuration
# ====================================================================

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Sessions
JWT_SECRET=medibrief-super-secure-cryptographic-jwt-secret-key-2026
JWT_EXPIRES_IN=7d

# Database Connection
# Default: SQLite (Zero-config out of the box)
DATABASE_URL=file:./medibrief.db
# PostgreSQL + pgvector alternative for production deployment:
# DATABASE_URL=postgresql://medibrief_user:medibrief_password@localhost:5432/medibrief

# Document Storage Provider: 'local' | 's3' | 'gcs'
STORAGE_PROVIDER=local
STORAGE_UPLOAD_DIR=./uploads
# AWS S3 (Production):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=medibrief-private-reports

# OCR Provider: 'local_medical' | 'google_vision' | 'aws_textract'
OCR_PROVIDER=local_medical
# OCR_API_KEY=

# AI & RAG Provider: 'local_medical' | 'gemini' | 'openai'
AI_PROVIDER=local_medical
GEMINI_API_KEY=
OPENAI_API_KEY=

# Mobile Authentication Provider: 'firebase' | 'mock'
OTP_PROVIDER=firebase
MOCK_OTP_CODE=123456

# Firebase Authentication (Phone Number Sign-In)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# Firebase Web App Client Config (Public keys - safe for frontend)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
